# ─────────────────────────────────────────────────────────────
# DramaStudio API — environment template
# Copy to .env and adjust. The Go binaries read real environment
# variables only (no .env autoload) — see docs/DEVELOPMENT.md for
# how to source this file on bash / PowerShell.
# ─────────────────────────────────────────────────────────────

# Runtime profile: development | staging | production
# development → sqlite + local workflow engine by default
DRAMASTUDIO_ENV=development

# HTTP server
PORT=9471
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Comma-separated CORS origins (leave empty for same-origin/dev proxy)
ALLOWED_ORIGINS=http://localhost:8742
# Public base URL used in generated links/webhooks
PUBLIC_URL=http://localhost:9471

# ── Persistence ──
# sqlite | postgres | memory (memory = tests only)
DRAMASTUDIO_STORE=sqlite
# sqlite file path (used when DRAMASTUDIO_STORE=sqlite)
DATABASE_PATH=data/dramastudio.db
MIGRATIONS_DIR=migrations
# postgres DSN (required when DRAMASTUDIO_STORE=postgres)
# DATABASE_URL=postgres://user:pass@localhost:5432/dramastudio?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# ── Cache / queue (optional) ──
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Workflow engine ──
# local = in-process pipeline (no server needed) | temporal = durable
WORKFLOW_ENGINE=local
# Required only when WORKFLOW_ENGINE=temporal:
# TEMPORAL_HOST_PORT=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=false

# ── Object storage ──
# local = filesystem under STORAGE_LOCAL_DIR | s3 = S3-compatible bucket
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/objects
# Required only when STORAGE_BACKEND=s3:
# S3_ENDPOINT=localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=dramastudio
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=false

# ── Security ──
# REQUIRE_AUTH=false injects a dev principal — fine for local testing.
# Set true in any real deployment (requires JWT_SECRET).
REQUIRE_AUTH=false
DEV_USER_ID=dev-user
DEV_ORG_ID=dev-org
# JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=24h
# SERVICE_TOKEN_SALT=
# Google SSO — ID tokens are verified server-side against this audience.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env.local.
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth client ID.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Observability ──
LOG_LEVEL=info
OTEL_SERVICE_NAME=dramastudio-api
# none | stdout
OTEL_TRACE_EXPORTER=none

# ── Provider webhooks ──
# HMAC secrets per provider, e.g. WEBHOOK_SECRET_mock / _openai / _wan
# WEBHOOK_SECRET_mock=dev-webhook-secret

# ── Scheduler (apps/scheduler) ──
# Poll interval for due publications, e.g. 30s
# SCHEDULER_INTERVAL=30s

# ── Publishing channel adapters (optional) ──
# YOUTUBE_API_KEY=       YOUTUBE_BASE_URL=
# TIKTOK_API_KEY=        TIKTOK_BASE_URL=
# INSTAGRAM_API_KEY=     INSTAGRAM_BASE_URL=

# NOTE: AI provider credentials are NOT env-based — register them via
# POST /v1/ai/providers (stored server-side, never returned in responses).
